# ==============================================================================
# Zephyr 2.0 / NetCoop AI - Systemd Service Unit
# Copy to: /etc/systemd/system/zephyr-control.service
# Enable: sudo systemctl enable --now zephyr-control
# Logs:   sudo journalctl -u zephyr-control -f
# ==============================================================================

[Unit]
Description=Zephyr 2.0 NOC Multi-Agent AI Control Plane
Documentation=https://github.com/Abhiwtv/zephyr2.0
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/zephyr2.0
EnvironmentFile=-/opt/zephyr2.0/.env

# Production execution using venv uvicorn workers
ExecStart=/opt/zephyr2.0/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --proxy-headers \
    --forwarded-allow-ips="*" \
    --ws websockets \
    --lifespan on

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5s

# Security sandboxing & limits
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zephyr-control

[Install]
WantedBy=multi-user.target
