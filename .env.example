# ==============================================================================
# Zephyr 2.0 / NetCoop AI - Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# Remote LLM & Inference Engine Settings
# URL of your Cloudflare tunnel, remote vLLM instance, or local Ollama server
ENGINE_URL=https://flux-epinions-gallery-proposition.trycloudflare.com
OLLAMA_MODEL=qwen3:14b
REASONER_TIMEOUT_SECONDS=90
VOTER_TIMEOUT_SECONDS=30

# FastApi Control Plane Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Cloud Control & Kaggle GPU Runner
KAGGLE_USER=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
ORACLE_HOST=your_oracle_vm_ip

# Storage & Persistence Paths
DATA_DIR=data
INCIDENT_MEMORY_PATH=data/incident_memory.json
BENCHMARK_DATASET_PATH=data/benchmark_dataset.jsonl
EVALUATION_RESULTS_PATH=data/evaluation_results.jsonl
OUTPUT_JSON_PATH=output.json

# Multi-Agent Consensus Parameters
CONSENSUS_THRESHOLD=0.70
MAX_DEBATE_ROUNDS=3
